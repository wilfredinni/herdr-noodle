+struct ScriptGutterMarker {
+    line: usize,
+    color: Option<String>,
+    deleted_before: Option<String>,
+    deleted_after: Option<String>,
+}
+fn gutter_marks(json: &str) -> Result<std::collections::BTreeMap<usize, gpui_base::input::EditorGutterMarker>> {
+    let marks: Vec<ScriptGutterMarker> = serde_json::from_str(json)?;
+    let color = |value: Option<String>| -> Result<Option<gpui::Hsla>> {
+        value.map(|v| crate::value::Bridged::Str(v).as_color().map_err(Into::into)).transpose()
+    };
+    marks.into_iter().map(|m| {
+        let row = m.line.checked_sub(1).ok_or_else(|| anyhow!("gutter line must be positive"))?;
+        Ok((row, gpui_base::input::EditorGutterMarker { color: color(m.color)?, deleted_before: color(m.deleted_before)?, deleted_after: color(m.deleted_after)? }))
+    }).collect()
+}
