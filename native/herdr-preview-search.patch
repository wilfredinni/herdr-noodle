+//! Retained Markdown search uses the rendered text, preserving formatting and links.
+use gpui::{AppContext, Context, Entity, Subscription};
+use gpui_base::{RangeHighlight, RenderedText, TextViewState};
+use gpui_base::input::{Rope, SearchMatcher};
+
+pub(crate) struct MarkdownSearch {
+    pub view: Entity<TextViewState>,
+    query: String,
+    matcher: SearchMatcher,
+    snapshot: Option<RenderedText>,
+    _subscription: Subscription,
+    owner: Option<gpui::WeakEntity<crate::view::ScriptView>>,
+}
+
+impl MarkdownSearch {
+    pub fn new(text: &str, cx: &mut Context<Self>) -> Self {
+        let view = cx.new(|cx| TextViewState::markdown(text, cx));
+        let subscription = cx.observe(&view, |this: &mut Self, view, cx| {
+            let snapshot = view.read(cx).rendered_text();
+            if this.snapshot.as_ref() != Some(&snapshot) {
+                if let Err(error) = this.apply(0, false, cx) {
+                    tracing::warn!(%error, "Markdown search refresh failed");
+                }
+                if let Some(owner) = &this.owner { let _ = owner.update(cx, |view, cx| view.refresh(cx)); }
+            }
+        });
+        Self { view, query: String::new(), matcher: SearchMatcher::new(), snapshot: None, _subscription: subscription, owner: crate::scope::current_view().map(|view| view.downgrade()) }
+    }
+
+    pub fn status(&self) -> String { self.matcher.label() }
+
+    pub fn value(&self, cx: &gpui::App) -> String {
+        self.view.read(cx).rendered_text().as_str().to_owned()
+    }
+
+    pub fn search(&mut self, query: &str, direction: i32, cx: &mut Context<Self>) -> anyhow::Result<String> {
+        if !(-1..=1).contains(&direction) { anyhow::bail!("search direction must be -1, 0 or 1"); }
+        if self.query != query {
+            self.query = query.to_owned();
+            self.matcher.update_query(query, false);
+        }
+        self.apply(direction, true, cx)
+    }
+
+    fn apply(&mut self, direction: i32, reveal: bool, cx: &mut Context<Self>) -> anyhow::Result<String> {
+        let snapshot = self.view.read(cx).rendered_text();
+        if self.snapshot.as_ref() != Some(&snapshot) {
+            self.matcher.update(&Rope::from(snapshot.as_str()));
+            self.snapshot = Some(snapshot);
+        }
+        if direction > 0 { self.matcher.next(); }
+        if direction < 0 { self.matcher.next_back(); }
+        let ranges = self.matcher.matched_ranges();
+        let active = self.matcher.current_match_index();
+        self.view.update(cx, |view, cx| -> anyhow::Result<()> {
+            view.set_range_highlights(ranges.iter().enumerate().map(|(index, range)| {
+                RangeHighlight::new(range.clone(), if index == active {
+                    gpui::hsla(0.07, 1.0, 0.5, 0.4)
+                } else { gpui::hsla(0.12, 1.0, 0.5, 0.22) })
+            }), cx)?;
+            if reveal && let Some(range) = ranges.get(active) { view.reveal_range(range.clone(), cx)?; }
+            Ok(())
+        })?;
+        Ok(self.matcher.label())
+    }
+}
